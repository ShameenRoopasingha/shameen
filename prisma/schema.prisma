generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String         @id @default(uuid())
  name        String
  role        String
  summary     String
  tagline     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProfileImage[]
  colorFilter String         @default("tva")
  resumeUrl   String?
}

model ProfileImage {
  id        String   @id @default(uuid())
  url       String
  isActive  Boolean  @default(false)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String    @id @default(uuid())
  role        String
  company     String
  year        String
  description String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startDate   DateTime  @default(now())
  endDate     DateTime?
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  techStack   String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  demoUrl     String?
  repoUrl     String?
  inDevelopment Boolean @default(false)
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  level     Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reference {
  id        String   @id @default(uuid())
  name      String
  company   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id        String   @id
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Feedback {
  id         String   @id @default(uuid())
  name       String
  company    String?
  message    String
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
